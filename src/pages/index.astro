---
import PageLayout from '../layouts/PageLayout.astro';
import ExperimentCard from '../components/ExperimentCard.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../utils/url';

const experiments = (await getCollection('experiments'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = experiments.filter((e) => e.data.featured).slice(0, 3);
---

<PageLayout title="Doris Lee" wide={true}>
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-main">
        <p class="hero-eyebrow">Physical AI · Robotics · Learning in public</p>
        <h1 class="hero-title">Hi, I'm Robododo 🤖</h1>
        <p class="hero-lead">
           After years of building in Data & ML, I'm now exploring the world of robotics and Physical AI.
          This is my field notebook documenting my experiments with robot learning, where I share lessons, discoveries, and challenges from my journey
  into robotics — from real-world robot learning to simulation and beyond. Stay tuned for more content coming soon!
        </p>
        <div class="hero-actions">
          <a href={withBase('/diary')} class="btn btn--primary">Read Robododo's Diary 🤖</a>
        </div>
      </div>
    </div>
  </section>

  <section class="latest" aria-labelledby="latest-heading">
    <div class="section-header">
      <h2 id="latest-heading">Latest Blogs</h2>
      <a href={withBase('/diary')} class="view-all">View all →</a>
    </div>
    <div class="experiment-grid">
      {featured.map((exp) => <ExperimentCard experiment={exp} />)}
    </div>
  </section>
</PageLayout>

<style>
  .hero {
    margin-bottom: 4rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 3rem;
    align-items: start;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent);
    letter-spacing: 0.04em;
    margin: 0 0 1rem;
  }

  .hero-title {
    margin: 0 0 1.25rem;
  }

  .hero-lead {
    font-size: 1.1875rem;
    color: var(--color-ink-muted);
    max-width: 38rem;
    margin: 0 0 1.75rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .btn {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 0.65rem 1.25rem;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background 0.15s, transform 0.15s;
  }

  .btn--primary {
    background: var(--color-accent);
    color: white;
  }

  .btn--primary:hover {
    background: #c04f30;
    color: white;
    transform: translateY(-1px);
  }

  .btn--secondary {
    background: var(--color-paper);
    color: var(--color-ink);
    border: 1px solid var(--color-paper-dark);
  }

  .btn--secondary:hover {
    background: var(--color-paper-warm);
    color: var(--color-ink);
  }

  .hero-links {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .hero-links span {
    color: var(--color-ink-faint);
  }

  .focus-panel {
    padding: 1.5rem;
    background: var(--color-paper-warm);
    border: 1px solid var(--color-paper-dark);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .panel-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink-faint);
    margin: 0 0 1rem;
  }

  .focus-list {
    margin: 0 0 1rem;
    padding-left: 1.125rem;
    font-size: 0.9375rem;
  }

  .focus-list li {
    margin-bottom: 0.35rem;
  }

  .panel-note {
    font-size: 0.8125rem;
    color: var(--color-ink-faint);
    font-style: italic;
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--color-paper-dark);
  }

  .latest {
    margin-bottom: 3rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    gap: 1rem;
  }

  .section-header h2 {
    margin: 0;
    font-size: 1.375rem;
  }

  .view-all {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  .experiment-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .about-snippet blockquote {
    margin: 0;
    padding: 1.5rem 2rem;
    background: var(--color-paper-warm);
    border-left: 4px solid var(--color-accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-style: italic;
    color: var(--color-ink-muted);
  }

  .about-snippet cite {
    display: block;
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-style: normal;
    color: var(--color-ink-faint);
  }

  @media (max-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
