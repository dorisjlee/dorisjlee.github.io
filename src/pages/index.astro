---
import PageLayout from '../layouts/PageLayout.astro';
import ExperimentCard from '../components/ExperimentCard.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../utils/url';
import { shorts } from '../data/shorts';

const experiments = (await getCollection('experiments'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = experiments.filter((e) => e.data.featured).slice(0, 3);

// Shorts carousel shows 2 videos side by side per page, paging through
// the rest if there are more than 2.
const shortsVisibleCount = Math.min(2, shorts.length);
const shortsPageCount = Math.ceil(shorts.length / shortsVisibleCount) || 1;
const shortCardWidthPercent = 100 / (shortsVisibleCount * shortsPageCount);
---

<PageLayout title="Doris Lee" wide={true}>
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-main">
        <p class="hero-eyebrow">Physical AI · Robotics · Learning in public</p>
        <h1 class="hero-title">Hi, I'm Doris 🤖</h1>
        <p class="hero-lead">
          I'm exploring the world of robotics and Physical AI.
          This is my field notebook documenting my experiments with robot learning, where I share lessons, discoveries, and challenges from my journey
  into robotics — from real-world robot learning to simulation and beyond. Stay tuned for more content coming soon!
        </p>
      </div>

      {shorts.length > 0 && (
        <div class="shorts-carousel" id="shorts-carousel">
          <div class="shorts-viewport">
            <div class="shorts-track" style={`width: ${shortsPageCount * 100}%`}>
              {shorts.map((short) => {
                const href = short.postSlug
                  ? withBase(`/diary/${short.postSlug}`)
                  : `https://www.youtube.com/shorts/${short.youtubeId}`;
                const external = !short.postSlug;
                return (
                  <a
                    href={href}
                    class="short-card"
                    style={`width: ${shortCardWidthPercent}%`}
                    target={external ? '_blank' : undefined}
                    rel={external ? 'noopener noreferrer' : undefined}
                  >
                    <div class="short-thumb">
                      <iframe
                        src={`https://www.youtube-nocookie.com/embed/${short.youtubeId}?autoplay=1&mute=1&loop=1&playlist=${short.youtubeId}&controls=0&modestbranding=1&playsinline=1&rel=0`}
                        title={short.caption}
                        loading="lazy"
                        frameborder="0"
                        allow="autoplay; encrypted-media"
                      ></iframe>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
          {shortsPageCount > 1 && (
            <div class="shorts-dots">
              {Array.from({ length: shortsPageCount }).map((_, i) => (
                <button class="short-dot" data-index={i} aria-label={`Show shorts page ${i + 1}`}></button>
              ))}
            </div>
          )}
        </div>
      )}
    </div>
  </section>

  <script>
    const carousel = document.getElementById('shorts-carousel');
    if (carousel) {
      const track = carousel.querySelector<HTMLElement>('.shorts-track');
      const dots = carousel.querySelectorAll<HTMLElement>('.short-dot');
      const pageCount = dots.length || 1;
      let page = 0;
      let timer: ReturnType<typeof setInterval>;

      function goTo(p: number) {
        page = (p + pageCount) % pageCount;
        if (track) track.style.transform = `translateX(-${(page * 100) / pageCount}%)`;
        dots.forEach((dot, di) => dot.classList.toggle('active', di === page));
      }

      function start() {
        timer = setInterval(() => goTo(page + 1), 6000);
      }

      function stop() {
        clearInterval(timer);
      }

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          goTo(i);
          stop();
          start();
        });
      });

      carousel.addEventListener('mouseenter', stop);
      carousel.addEventListener('mouseleave', start);

      goTo(0);
      if (pageCount > 1) start();
    }
  </script>

  <section class="latest" aria-labelledby="latest-heading">
    <div class="section-header">
      <h2 id="latest-heading">Latest Blogs</h2>
      <a href={withBase('/diary')} class="view-all">View all →</a>
    </div>
    <div class="experiment-grid">
      {featured.map((exp) => <ExperimentCard experiment={exp} />)}
    </div>
  </section>
</PageLayout>

<style>
  .hero {
    margin-bottom: 4rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 3rem;
    align-items: start;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent);
    letter-spacing: 0.04em;
    margin: 0 0 1rem;
  }

  .hero-title {
    margin: 0 0 1.25rem;
  }

  .hero-lead {
    font-size: 1.1875rem;
    color: var(--color-ink-muted);
    max-width: 38rem;
    margin: 0 0 1.75rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .btn {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 0.65rem 1.25rem;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background 0.15s, transform 0.15s;
  }

  .btn--primary {
    background: var(--color-accent);
    color: white;
  }

  .btn--primary:hover {
    background: #c04f30;
    color: white;
    transform: translateY(-1px);
  }

  .btn--secondary {
    background: var(--color-paper);
    color: var(--color-ink);
    border: 1px solid var(--color-paper-dark);
  }

  .btn--secondary:hover {
    background: var(--color-paper-warm);
    color: var(--color-ink);
  }

  .hero-links {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .hero-links span {
    color: var(--color-ink-faint);
  }

  .focus-panel {
    padding: 1.5rem;
    background: var(--color-paper-warm);
    border: 1px solid var(--color-paper-dark);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .panel-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink-faint);
    margin: 0 0 1rem;
  }

  .focus-list {
    margin: 0 0 1rem;
    padding-left: 1.125rem;
    font-size: 0.9375rem;
  }

  .focus-list li {
    margin-bottom: 0.35rem;
  }

  .panel-note {
    font-size: 0.8125rem;
    color: var(--color-ink-faint);
    font-style: italic;
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--color-paper-dark);
  }

  .latest {
    margin-bottom: 3rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    gap: 1rem;
  }

  .section-header h2 {
    margin: 0;
    font-size: 1.375rem;
  }

  .view-all {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  .experiment-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .shorts-carousel {
    width: 100%;
  }

  .shorts-viewport {
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .shorts-track {
    display: flex;
    transition: transform 0.4s ease;
  }

  .short-card {
    display: block;
    flex-shrink: 0;
    text-decoration: none;
    color: inherit;
    padding: 0 0.125rem;
    box-sizing: border-box;
  }

  .shorts-dots {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .short-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    border: none;
    padding: 0;
    background: var(--color-paper-dark);
    cursor: pointer;
  }

  .short-dot.active {
    background: var(--color-accent);
  }

  .short-thumb {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-paper-warm);
    border: 1px solid var(--color-paper-dark);
    box-shadow: var(--shadow-sm);
    transition: transform 0.15s;
  }

  .short-card:hover .short-thumb {
    transform: translateY(-2px);
  }

  .short-thumb iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    /* No controls and autoplaying — disable interaction so clicks on the
       card fall through to the wrapping <a>, since an iframe would
       otherwise swallow the click before it reaches the link. */
    pointer-events: none;
  }

  .about-snippet blockquote {
    margin: 0;
    padding: 1.5rem 2rem;
    background: var(--color-paper-warm);
    border-left: 4px solid var(--color-accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-style: italic;
    color: var(--color-ink-muted);
  }

  .about-snippet cite {
    display: block;
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-style: normal;
    color: var(--color-ink-faint);
  }

  @media (max-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
